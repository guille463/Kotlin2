<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Boletín de evaluación" style="@style/TituloPantalla" />
        <!-- TODO: construye la interfaz completa siguiendo los id del PDF:
             etBloque1, etBloque2, etBloque3 (decimales), btnEvaluar, btnLimpiar, tvNota, tvEstado.
             Aplica los estilos definidos en res/values/styles.xml. -->
        <EditText
            android:id="@+id/etBloque1"
            style="@style/CampoFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="Nota Bloque 1"/>
        <EditText
            android:id="@+id/etBloque2"
            style="@style/CampoFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="Nota Bloque 2"/>
        <EditText
            android:id="@+id/etBloque3"
            style="@style/CampoFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="Nota Bloque 3"/>

        <Button
            android:id="@+id/btnEvaluar"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Evaluar"
           />

        <Button
            android:id="@+id/btnLimpiar"
            style="@style/BotonSecundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Limpiar"
          />

        <TextView
            android:id="@+id/tvNota"
            style="@style/TextoResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nota final" />

        <TextView
            android:id="@+id/tvEstado"
            style="@style/TextoResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado"/>
    </LinearLayout>
</ScrollView>
