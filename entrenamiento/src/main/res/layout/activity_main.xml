<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_app">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/TituloPantalla"
            android:text="Registro de entrenamiento" />


        <EditText
            android:id="@+id/etNombre"
            style="@style/CampoFormulario"
            android:hint="Nombre"
            android:inputType="textPersonName"
            android:maxLines="1" />


        <EditText
            android:id="@+id/etMinutos"
            style="@style/CampoFormulario"
            android:hint="Minutos (1-300)"
            android:inputType="number"
            android:maxLength="3" />


        <EditText
            android:id="@+id/etIntensidad"
            style="@style/CampoFormulario"
            android:hint="Intensidad (1-10)"
            android:inputType="number"
            android:maxLength="2" />


        <Button
            android:id="@+id/btnRegistrar"
            style="@style/BotonPrincipal"
            android:text="Registrar" />


        <Button
            android:id="@+id/btnLimpiar"
            style="@style/BotonSecundario"
            android:text="Limpiar" />


        <TextView
            android:id="@+id/tvResultado"
            style="@style/TextoResultado"
            android:text="Introduce los datos de la sesión" />

    </LinearLayout>
</ScrollView>