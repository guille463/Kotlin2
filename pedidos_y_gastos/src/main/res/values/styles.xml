<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TODO: añade aquí los estilos TituloPantalla, CampoFormulario,
         BotonPrincipal, BotonSecundario y TextoResultado.
         Consulta el tutorial breve de estilos del PDF. -->
   <style name="TituloPantalla">
       <item name="android:layout_width">match_parent</item>
       <item name="android:layout_height">wrap_content</item>
       <item name="android:textSize">24sp</item>
       <item name="android:color">@color/azul_principal</item>
   </style>

    <style name="CampoFormulario">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:titleMarginBottom">8dp</item>
    </style>

    <style name="BotonPrincipal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:backgroundTint">@color/turquesa</item>
        <item name="android:textColor">@color/blanco</item>
    </style>

    <style name="BotonSecundario">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:backgroundTint">@color/texto_secundario</item>
        <item name="android:textColor">@color/blanco</item>
    </style>

    <style name="TextoResultado">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>
</resources>
