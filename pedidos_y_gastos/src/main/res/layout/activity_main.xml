<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/TituloPantalla"
            android:gravity="center"
            android:text="Pedido con gastos de envío" />

        <EditText
            android:id="@+id/etImporte"
            style="@style/CampoFormulario"
            android:hint="Importe de productos (€)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etPeso"
            style="@style/CampoFormulario"
            android:hint="Peso (kg, máx. 30)"
            android:inputType="numberDecimal" />

        <CheckBox
            android:id="@+id/cbUrgente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Envío urgente" />

        <Button
            android:id="@+id/btnCalcular"
            style="@style/BotonPrincipal"
            android:text="Calcular" />

        <Button
            android:id="@+id/btnLimpiar"
            style="@style/BotonSecundario"
            android:text="Limpiar" />

        <TextView
            android:id="@+id/tvResultado"
            style="@style/TextoResultado"
            android:text="Introduce importe y peso" />

    </LinearLayout>
</ScrollView>